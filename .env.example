# Asha node environment template -- copy to `.env` and fill in.
# Asha is stdlib-only: nothing loads this file automatically.
# Activate it in bash:      set -a; . ./.env; set +a
# PowerShell:               Get-Content .env | ForEach-Object { ... } or set them manually.

# Live LLM semantic reviewer (fail-closed gate). Leave the flag unset/off
# to keep the reviewer disabled: the gate then denies via the
# 'missing artifact' INVALID_EVIDENCE path (never a silent pass).
ASHA_SEMANTIC_REVIEW=live
ASHA_LLM_API_KEY=REPLACE_ME
ASHA_LLM_BASE_URL=https://api.deepseek.com
ASHA_LLM_MODEL=deepseek-chat
ASHA_LLM_TIMEOUT_S=120
ASHA_LLM_MAX_TOKENS=4096
ASHA_LLM_TEMPERATURE=0.0
ASHA_REVIEW_CONTEXT_BUDGET=60000

# State + graph cache (defaults live under the repo / XDG-style home).
# ASHA_STATE_DIR=/var/lib/asha/state
# ASHA_GRAPH_CACHE_DIR=/var/cache/asha/graph
