--- a/pydetactl/src/utils/s3_resolver.py
+++ b/pydetactl/src/utils/s3_resolver.py
@@ -11,7 +11,11 @@ from typing import Any, Dict, List, Set
 from services.s3_client import S3Client
 
 # Pattern for detecting s3:// URLs
-_S3_URL_PATTERN = re.compile(r"s3://[^\s]+")
+_S3_URL_PATTERN = re.compile(r"s3://\S+")
+# Pattern for detecting HTTP(S) URLs (kept only when they point at S3)
+_HTTP_URL_PATTERN = re.compile(r"https?://\S+")
+# Prose punctuation that may sit right after a URL embedded in a sentence
+_TRAILING_PUNCTUATION = ").,;:!?'\"`]}>"
 
 
 def detect_s3_urls(data: Any) -> List[str]:
@@ -39,13 +43,15 @@ def detect_s3_urls(data: Any) -> List[str]:
         elif isinstance(current, list):
             stack.extend(current)
         elif isinstance(current, str):
-            # Check for s3:// URLs
-            matches = _S3_URL_PATTERN.findall(current)
-            urls.update(matches)
-
-            # Check if entire string is an HTTP(S) or scheme-less S3 URL
-            if ("/s3/" in current or ".s3." in current) and "/" in current:
-                urls.add(current)
+            # Only the URL token is returned, never the sentence around it.
+            # shortcut: rstrip also trims keys that genuinely end in punctuation;
+            # switch to urllib.parse tokenising if such keys appear in the wild.
+            for match in _S3_URL_PATTERN.findall(current):
+                urls.add(match.rstrip(_TRAILING_PUNCTUATION))
+            for match in _HTTP_URL_PATTERN.findall(current):
+                url = match.rstrip(_TRAILING_PUNCTUATION)
+                if "/s3/" in url or ".s3." in url:
+                    urls.add(url)
     return list(urls)
 
 
