diff --git a/pydetactl/tests/test_s3_resolver.py b/pydetactl/tests/test_s3_resolver.py
index 6632717f2..c9660a912 100644
--- a/pydetactl/tests/test_s3_resolver.py
+++ b/pydetactl/tests/test_s3_resolver.py
@@ -133,3 +133,34 @@ async def test_resolve_s3_artifacts_with_urls(mock_detect, mock_s3_client_class)
     mock_detect.assert_called_once_with(result)
     mock_s3_client_class.assert_called_once()
     assert mock_client.fetch_artifact.call_count == 2
+
+
+@pytest.mark.asyncio
+@patch("utils.s3_resolver.S3Client")
+@patch("utils.s3_resolver.detect_s3_urls")
+async def test_resolve_s3_artifacts_fetch_failure_keeps_stdout_clean(
+    mock_detect, mock_s3_client_class, capsys
+):
+    """A failed fetch is non-fatal and must not write a byte to stdout."""
+    mock_detect.return_value = [
+        "s3://bucket/broken.yaml",
+        "s3://bucket/ok.yaml",
+    ]
+
+    mock_client = Mock()
+    mock_client.fetch_artifact = AsyncMock(
+        side_effect=[
+            RuntimeError("boom"),
+            {"source": "s3://bucket/ok.yaml", "content": {"data": 2}},
+        ]
+    )
+    mock_s3_client_class.return_value = mock_client
+
+    artifacts = await resolve_s3_artifacts({"name": "test"})
+
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert "Failed to fetch s3://bucket/broken.yaml" in captured.err
+    assert artifacts == [
+        {"source": "s3://bucket/ok.yaml", "content": {"data": 2}}
+    ]
