@@ -0,0 +1,77 @@
+"""Tests for the shared S3 URL grammar and its resolver/client round trip."""
+
+import pytest
+
+from services.s3_client import S3Client
+from utils.s3_resolver import detect_s3_urls
+from utils.s3_url import find_s3_urls, parse_s3_url
+
+# __new__ skips __init__: parsing needs no settings/Minio connection.
+PARSER = S3Client.__new__(S3Client)
+
+
+@pytest.mark.parametrize(
+    "url, expected",
+    [
+        ("s3://bucket/key/file.yaml", ("bucket", "key/file.yaml")),
+        ("https://minio.local:9000/bucket/key", ("bucket", "key")),
+        ("http://minio.local:9000/bucket/key/file", ("bucket", "key/file")),
+        ("minio.local:9000/bucket/key", ("bucket", "key")),
+        ("s3://bucket", None),
+        ("s3://bucket/", None),
+        ("https://minio.local", None),
+        ("https://bucket.s3.amazonaws.com/key", None),
+        ("", None),
+    ],
+)
+def test_parse_s3_url(url, expected):
+    assert parse_s3_url(url) == expected
+
+
+def test_find_s3_urls_extracts_only_parseable_candidates():
+    text = (
+        "made s3://bucket/a.yaml and https://minio.s3.local:9000/bucket/b.yaml "
+        "plus https://bucket.s3.amazonaws.com/not-parseable"
+    )
+    assert set(find_s3_urls(text)) == {
+        "s3://bucket/a.yaml",
+        "https://minio.s3.local:9000/bucket/b.yaml",
+    }
+
+
+def test_find_s3_urls_ignores_plain_http_and_empty_input():
+    assert find_s3_urls("") == []
+    assert find_s3_urls("http://example.com/file.yaml") == []
+    assert find_s3_urls("just a string") == []
+
+
+CORPUS = [
+    "s3://bucket/file.yaml",
+    "s3://bucket/nested/dir/file.json",
+    "https://minio.s3.local:9000/bucket/file.yaml",
+    "http://minio.s3.local:9000/bucket/dir/file.yaml",
+    "see s3://bucket/a.yaml and http://minio.s3.local:9000/bucket/b.yaml",
+    {
+        "results": [
+            "s3://bucket/x.yaml",
+            {"url": "https://minio.s3.local:9000/b2/y.json"},
+        ]
+    },
+    "http://example.com/file.yaml",
+    "https://bucket.s3.amazonaws.com/key",
+    "s3://bucket",
+    "no urls here",
+    {"n": None, "x": 1},
+]
+
+
+@pytest.mark.parametrize("payload", CORPUS)
+def test_detected_urls_are_always_parseable_by_the_client(payload):
+    for url in detect_s3_urls(payload):
+        bucket, key = PARSER._parse_s3_url(url)
+        assert bucket and key
+        assert parse_s3_url(url) == (bucket, key)
+
+
+def test_unparseable_virtual_hosted_url_is_not_detected():
+    assert detect_s3_urls("https://bucket.s3.amazonaws.com/key") == []
