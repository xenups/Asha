diff --git a/pydetactl/src/utils/s3_url.py b/pydetactl/src/utils/s3_url.py
new file mode 100644
index 000000000..00ca0a7f7
--- /dev/null
+++ b/pydetactl/src/utils/s3_url.py
@@ -0,0 +1,46 @@
+"""S3 URL recognition and parsing — the single source of truth.
+
+Both discovery (utils.s3_resolver) and fetching (services.s3_client) must
+agree on what counts as an S3 URL, so every scheme decision lives here.
+"""
+
+import re
+from typing import List, Optional, Tuple
+
+_S3_URI_RE = re.compile(r"s3://[^\s\"'<>]+")
+_TOKEN_RE = re.compile(r"[^\s\"'<>]+")
+
+
+def parse_s3_url(url: str) -> Optional[Tuple[str, str]]:
+    """Return (bucket, key) when url is an S3 URL, else None.
+
+    Accepted forms:
+    - s3://bucket/key
+    - http(s)://endpoint/bucket/key
+    - endpoint/bucket/key (scheme-less)
+
+    Both bucket and key must be non-empty.
+    """
+    if url.startswith("s3://"):
+        bucket, _, key = url[5:].partition("/")
+    else:
+        for scheme in ("https://", "http://"):
+            if url.startswith(scheme):
+                url = url[len(scheme) :]
+                break
+        _endpoint, _, path = url.partition("/")
+        bucket, _, key = path.partition("/")
+    return (bucket, key) if bucket and key else None
+
+
+def find_s3_urls(text: str) -> List[str]:
+    """Return the S3 URLs embedded in text; unparseable candidates dropped."""
+    if not text:
+        return []
+    urls = [u for u in _S3_URI_RE.findall(text) if parse_s3_url(u)]
+    urls += [
+        t
+        for t in _TOKEN_RE.findall(text)
+        if ("/s3/" in t or ".s3." in t) and parse_s3_url(t)
+    ]
+    return urls
