diff --git a/pydetactl/src/utils/s3_resolver.py b/pydetactl/src/utils/s3_resolver.py
index 1fd6c9c4d..e5711e618 100644
--- a/pydetactl/src/utils/s3_resolver.py
+++ b/pydetactl/src/utils/s3_resolver.py
@@ -10,8 +10,11 @@ from typing import Any, Dict, List, Set
 
 from services.s3_client import S3Client
 
-# Pattern for detecting s3:// URLs
-_S3_URL_PATTERN = re.compile(r"s3://[^\s]+")
+# Pattern for detecting candidate URL tokens (s3://, HTTP(S) or scheme-less)
+_S3_URL_PATTERN = re.compile(r"\S+")
+
+# Punctuation that prose may glue to the end of a URL
+_TRAILING_PUNCTUATION = ".,;:!?)]}'\""
 
 
 def detect_s3_urls(data: Any) -> List[str]:
@@ -39,13 +42,13 @@ def detect_s3_urls(data: Any) -> List[str]:
         elif isinstance(current, list):
             stack.extend(current)
         elif isinstance(current, str):
-            # Check for s3:// URLs
-            matches = _S3_URL_PATTERN.findall(current)
-            urls.update(matches)
-
-            # Check if entire string is an HTTP(S) or scheme-less S3 URL
-            if ("/s3/" in current or ".s3." in current) and "/" in current:
-                urls.add(current)
+            # Take only the URL token itself, not the sentence around it
+            for token in _S3_URL_PATTERN.findall(current):
+                url = token.rstrip(_TRAILING_PUNCTUATION)
+                if "/" in url and (
+                    url.startswith("s3://") or "/s3/" in url or ".s3." in url
+                ):
+                    urls.add(url)
     return list(urls)
 
 
