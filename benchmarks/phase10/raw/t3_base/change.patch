@@ -0,0 +1,101 @@
+"""Tests for the shared S3 URL helper and the resolver/client round-trip."""
+
+import pytest
+
+from services.s3_client import S3Client, parse_s3_url
+from utils.s3_resolver import detect_s3_urls
+
+
+class TestParseS3Url:
+    """Tests for the shared pure parse_s3_url helper."""
+
+    @pytest.mark.parametrize(
+        ("url", "expected"),
+        [
+            ("s3://bucket/key.yaml", ("bucket", "key.yaml")),
+            ("s3://bucket/path/to/key.yaml", ("bucket", "path/to/key.yaml")),
+            ("http://minio:9000/bucket/key.yaml", ("bucket", "key.yaml")),
+            ("https://minio:9000/bucket/path/key.yaml", ("bucket", "path/key.yaml")),
+            ("minio:9000/bucket/key.yaml", ("bucket", "key.yaml")),
+            (
+                "https://s3.example.com/bucket/path/key.yaml",
+                ("bucket", "path/key.yaml"),
+            ),
+        ],
+    )
+    def test_parses_supported_shapes(self, url, expected):
+        assert parse_s3_url(url) == expected
+
+    @pytest.mark.parametrize(
+        "url",
+        [
+            "",
+            "s3://",
+            "s3://bucket",
+            "s3://bucket/",
+            "s3:///key.yaml",
+            "http://example.com",
+            "http://example.com/bucket",
+            "not a url",
+        ],
+    )
+    def test_rejects_unparseable(self, url):
+        assert parse_s3_url(url) is None
+
+
+class TestClientParseContract:
+    """S3Client._parse_s3_url keeps its contract on top of the helper."""
+
+    def setup_method(self):
+        # Parsing needs no MinIO connection, so skip __init__ / settings
+        self.client = S3Client.__new__(S3Client)
+
+    def test_returns_bucket_and_key(self):
+        assert self.client._parse_s3_url("s3://bucket/key.yaml") == (
+            "bucket",
+            "key.yaml",
+        )
+        assert self.client._parse_s3_url("http://host:9000/bucket/key") == (
+            "bucket",
+            "key",
+        )
+
+    def test_raises_on_invalid_url(self):
+        with pytest.raises(ValueError, match="Invalid S3 URL format"):
+            self.client._parse_s3_url("s3://bucket")
+
+
+class TestResolverClientRoundTrip:
+    """Every URL the resolver returns must be parseable by the client."""
+
+    CORPUS = [
+        "s3://bucket/file.yaml",
+        "s3://bucket/deep/path/file.yaml",
+        "see s3://bucket/file.yaml for details",
+        {"url": "s3://bucket/nested.yaml"},
+        {"nested": [{"url": "s3://bucket/listed.yaml"}]},
+        "https://minio.s3.example.com/bucket/path/file.yaml",
+        "https://s3.example.com/bucket/file.yaml",
+        "http://example.com/file.yaml",
+        "s3://bucket",
+        "s3://bucket/",
+        "https://bucket.s3.amazonaws.com/key.yaml",
+        "just a string",
+        "",
+        None,
+        42,
+    ]
+
+    def test_resolver_output_always_parses(self):
+        client = S3Client.__new__(S3Client)
+
+        for fixture in self.CORPUS:
+            for url in detect_s3_urls(fixture):
+                bucket, key = client._parse_s3_url(url)
+                assert bucket and key, (fixture, url)
+
+    def test_resolver_drops_unparseable_s3_urls(self):
+        assert detect_s3_urls("s3://bucket") == []
+        assert detect_s3_urls("s3://bucket/") == []
+        assert detect_s3_urls("https://bucket.s3.amazonaws.com/key.yaml") == []
+        assert detect_s3_urls("s3://bucket/key.yaml") == ["s3://bucket/key.yaml"]
