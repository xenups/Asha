+def parse_s3_url(url: str) -> Optional[Tuple[str, str]]:
+    """
+    Parse an S3 URL into (bucket, key). Pure; returns None when unparseable.
+
+    Supports both S3 URL shapes used in pydetactl:
+    - s3://bucket/key/path
+    - http(s)://endpoint/bucket/key/path (and the same without a scheme)
+
+    This is the single place that knows S3 URL syntax: callers use a non-None
+    result both to recognise an S3 URL and to get its bucket and key.
+    """
+    if url.startswith("s3://"):
+        bucket, sep, key = url.removeprefix("s3://").partition("/")
+        return (bucket, key) if sep and bucket and key else None
+
+    # Format: endpoint/bucket/key
+    path = url.removeprefix("https://").removeprefix("http://").partition("/")[2]
+    bucket, sep, key = path.partition("/")
+    if not (sep and bucket and key):
+        return None
+    return bucket, key
+
+
